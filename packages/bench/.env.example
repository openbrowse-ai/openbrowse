# Copy this file to `.env` (which is gitignored) and fill in the keys you
# want to use. The bench harness loads `.env` automatically — no need to
# source it manually before each run.
#
# Lookup order:
#   1. packages/bench/.env       (this directory; per-package override)
#   2. <workspace-root>/.env     (shared across the monorepo)
#   3. shell environment         (already in process.env)
#
# You only need keys for the providers you actually exercise. Common case:
# the judge always runs Gemini, so GOOGLE_GENERATIVE_AI_API_KEY is required
# for any task that uses the `llm-judge` evaluator.

# Anthropic — for `claude-*` model ids
ANTHROPIC_API_KEY=

# OpenAI — for `gpt-*` and `o*` model ids
OPENAI_API_KEY=

# Google — used by the agent (when running gemini-* models) AND by the
# judge (Gemini 2.5 Flash). Required for any task with an `llm-judge`
# evaluator.
GOOGLE_GENERATIVE_AI_API_KEY=

# Kernel — required when running with `--driver kernel`
KERNEL_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Optional: Cloudflare R2 upload.
#
# When all five R2_* vars below are set, `bench` automatically uploads
# run artifacts (lightweight trial JSONs + zstd-compressed full traces +
# videos) to your bucket alongside the local `.bench/runs/<run-id>/`
# directory. To force off, pass `--no-upload`. To force on, pass
# `--upload always`.
#
# Uploading also requires `--eval-set <name>` and `--arm <name>` so
# manifests are traceable. The bench CLI errors out otherwise.
# ─────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
