{
  "name": "@openbrowse/bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evaluation harness for the OpenBrowse agent. Runs the agent headlessly via Playwright across a matrix of model × prompt × tool-set configurations.",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "bench": "tsx src/cli.ts",
    "baseline": "tsx scripts/bench-baseline.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.67",
    "@aws-sdk/client-s3": "^3.1054.0",
    "@huggingface/hub": "^2.12.0",
    "@onkernel/sdk": "^0.58.0",
    "ai": "^6.0.193",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "parquetjs": "^0.11.2",
    "playwright": "^1.50.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
